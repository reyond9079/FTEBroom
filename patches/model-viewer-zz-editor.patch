+    memset(&entity,0,sizeof(entity));entity.model=model;entity.scale=1;entity.playerindex=-1;
+    entity.framestate.g[FS_REG].lerpweight[0]=1;entity.framestate.g[FS_REG].endbone=0x7fffffff;
+    for(surface=model->meshinfo;surface&&s<256;surface=surface->nextsurf,s++){
+        mesh_t mesh;vec3_t low={FLT_MAX,FLT_MAX,FLT_MAX},high={-FLT_MAX,-FLT_MAX,-FLT_MAX};
+        memset(&mesh,0,sizeof(mesh));Alias_FlushCache();Alias_GAliasBuildMesh(&mesh,NULL,surface,s,&entity,false);
+        if(!mesh.xyz_array)break;
+        for(v=0;v<mesh.numvertexes;v++)for(a=0;a<3;a++){low[a]=min(low[a],mesh.xyz_array[v][a]);high[a]=max(high[a],mesh.xyz_array[v][a]);}
+        snprintf(key,sizeof(key),"ftebroom_modeleditor_mesh_%d_name",s);Cvar_Set(Cvar_Get(key,"",0,""),surface->surfacename);
+        snprintf(key,sizeof(key),"ftebroom_modeleditor_mesh_%d_low",s);snprintf(value,sizeof(value),"%.9g %.9g %.9g",low[0],low[1],low[2]);Cvar_Set(Cvar_Get(key,"",0,""),value);
+        snprintf(key,sizeof(key),"ftebroom_modeleditor_mesh_%d_high",s);snprintf(value,sizeof(value),"%.9g %.9g %.9g",high[0],high[1],high[2]);Cvar_Set(Cvar_Get(key,"",0,""),value);
+    }
+    Alias_FlushCache();snprintf(value,sizeof(value),"%d",s);Cvar_Set(Cvar_Get("ftebroom_modeleditor_meshes","0",0,""),value);
+}
