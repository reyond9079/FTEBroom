+static const char *X11CursorShapeName(int shape)
+{
+	switch(shape)
+	{
+	case 1: return "left_ptr";
+	case 4: return "hand2";
+	case 5: return "progress";
+	case 6: return "watch";
+	case 9: return "xterm";
+	case 15: return "not-allowed";
+	case 26: return "ew-resize";
+	case 27: return "ns-resize";
+	case 28: return "nesw-resize";
+	case 29: return "nwse-resize";
+	case 32: return "fleur";
+	default: return NULL;
+	}
+}
+static const char *X11CursorShapeAlias(int shape)
+{
+	switch(shape)
+	{
+	case 1: return "default";
+	case 4: return "pointer";
+	case 9: return "text";
+	case 15: return "crossed_circle";
+	case 26: return "sb_h_double_arrow";
+	case 27: return "sb_v_double_arrow";
+	case 28: return "bottom_left_corner";
+	case 29: return "bottom_right_corner";
+	case 32: return "all-scroll";
+	default: return NULL;
+	}
+}
+static void X11_ClearShapeCursor(void)
+{
+	Cursor old = vid_shapecursor;
+	vid_shapecursor = None;
+	vid_shapecursorid = 0;
+	if (old && vid_dpy)
+	{
+		UpdateGrabs();
+		x11.pXFreeCursor(vid_dpy, old);
+	}
+}
+static qboolean X11VID_SetCursorShape(int shape)
+{
+	Cursor cursor = None;
+	Cursor old;
+	const char *name, *alias;
+	if (shape <= 0)
+	{
+		X11_ClearShapeCursor();
+		return true;
+	}
+	if (!vid_dpy || !xcursor.LibraryLoadCursor)
+		return false;
+	if (vid_shapecursor && vid_shapecursorid == shape)
+		return true;
+
+	name = X11CursorShapeName(shape);
+	alias = X11CursorShapeAlias(shape);
+	if (name)
+		cursor = xcursor.LibraryLoadCursor(vid_dpy, name);
+	if (!cursor && alias)
+		cursor = xcursor.LibraryLoadCursor(vid_dpy, alias);
+	if (!cursor)
+		return false;
+
+	old = vid_shapecursor;
+	vid_shapecursor = cursor;
+	vid_shapecursorid = shape;
+	vid_newcursor = None;
+	UpdateGrabs();
+	if (old && old != cursor)
+		x11.pXFreeCursor(vid_dpy, old);
+	return true;
+}
 static qboolean X11VID_SetCursor(void *qcursor)
