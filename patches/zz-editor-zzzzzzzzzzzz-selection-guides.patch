+                else {float x=(brush->mins[axis]-lines[ray*2][axis])/direction[axis],y=(brush->maxs[axis]-lines[ray*2][axis])/direction[axis];enter=max(enter,min(x,y));leave=min(leave,max(x,y));if(enter>leave){valid=false;break;}}
