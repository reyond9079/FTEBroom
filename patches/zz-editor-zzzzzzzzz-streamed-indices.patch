+// Version 1 URI-list drops. No shell and no execution of dropped file contents.
+typedef struct wl_drop_offer_s {
+    struct wl_data_offer *offer;
+    qboolean uris;
+    struct wl_drop_offer_s *next;
+} wl_drop_offer_t;
+static struct wl_data_device_manager *dropmanager;
+static struct wl_data_device *dropdevice;
+static wl_drop_offer_t *dropoffers, *dropactive;
+static int dropfd = -1;
+static char droptext[262145];
+static size_t dropsize;
+static double dropdeadline;
+static void WL_DropFree(wl_drop_offer_t *entry)
+{
+    wl_drop_offer_t **link;
+    if (!entry) return;
+    for (link=&dropoffers; *link && *link!=entry; link=&(*link)->next) {}
+    if (*link) *link=entry->next;
+    pwl_proxy_marshal((struct wl_proxy*)entry->offer, WL_DATA_OFFER_DESTROY);
+    pwl_proxy_destroy((struct wl_proxy*)entry->offer);
+    if (dropactive==entry) dropactive=NULL;
+    Z_Free(entry);
+}
+static void WL_DropMime(void *data, struct wl_data_offer *offer, const char *mime)
+{ if (!strcmp(mime,"text/uri-list")) ((wl_drop_offer_t*)data)->uris=true; }
+static const struct wl_data_offer_listener drop_offer_listener = { .offer=WL_DropMime };
+static void WL_DropOffer(void *data, struct wl_data_device *device, struct wl_data_offer *offer)
+{
+    wl_drop_offer_t *entry=Z_Malloc(sizeof(*entry));
+    entry->offer=offer;entry->next=dropoffers;dropoffers=entry;
+    pwl_proxy_add_listener((struct wl_proxy*)offer,(void (**)(void))&drop_offer_listener,entry);
+}
+static void WL_DropEnter(void *data, struct wl_data_device *device, uint32_t serial, struct wl_surface *surface, wl_fixed_t x, wl_fixed_t y, struct wl_data_offer *offer)
+{
+    wl_drop_offer_t *entry;
+    if (dropfd>=0) return;
+    for(entry=dropoffers;entry && entry->offer!=offer;entry=entry->next) {}
+    dropactive=entry;
+    if(entry) pwl_proxy_marshal((struct wl_proxy*)offer,WL_DATA_OFFER_ACCEPT,serial,
+        entry->uris && COM_CheckParm("-ftebroom-child-processes") ? "text/uri-list" : NULL);
+}
+static void WL_DropLeave(void *data, struct wl_data_device *device)
+{ if(dropfd<0) WL_DropFree(dropactive); }
+static void WL_DropMotion(void *data, struct wl_data_device *device, uint32_t time, wl_fixed_t x, wl_fixed_t y) {}
+static void WL_DropReceive(void *data, struct wl_data_device *device)
+{
+    int fds[2];
+    if(!dropactive || !dropactive->uris || dropfd>=0 || !COM_CheckParm("-ftebroom-child-processes")) return;
+    if(pipe(fds)) return;
+    fcntl(fds[0],F_SETFL,O_NONBLOCK);fcntl(fds[0],F_SETFD,FD_CLOEXEC);
+    pwl_proxy_marshal((struct wl_proxy*)dropactive->offer,WL_DATA_OFFER_RECEIVE,"text/uri-list",fds[1]);
+    close(fds[1]);dropfd=fds[0];dropsize=0;dropdeadline=Sys_DoubleTime()+10;
+}
+static void WL_DropSelection(void *data, struct wl_data_device *device, struct wl_data_offer *offer)
+{
+    wl_drop_offer_t *entry;
+    for(entry=dropoffers;entry && entry->offer!=offer;entry=entry->next) {}
+    if(entry!=dropactive) WL_DropFree(entry);
+}
+static const struct wl_data_device_listener drop_device_listener = {
+    WL_DropOffer,WL_DropEnter,WL_DropLeave,WL_DropMotion,WL_DropReceive,WL_DropSelection
