+// Retry rejected editor brush faces in double precision; retain the normal fast path.
+static unsigned int Terr_EditorClipFace(vecV_t *out, unsigned int capacity, vec4_t *planes, unsigned int count, unsigned int face)
+{
+ unsigned int result = Fragment_ClipPlaneToBrush(out, capacity, planes, sizeof(*planes), count, planes[face]);
+ double vertices[2][512][3], normal[3], right[3], up[3], origin[3], length, dot;
+ unsigned int i, j, k, side = 0, total = 4;
+ if (result || count < 4 || count > 256) return result;
+ for (k=0;k<3;k++) normal[k]=planes[face][k];
+ length=normal[0]*normal[0]+normal[1]*normal[1]+normal[2]*normal[2];
+ if (length < 1e-20) return 0;
+ for(k=0;k<3;k++) origin[k]=normal[k]*planes[face][3]/length;
+ if(fabs(normal[2])>fabs(normal[0]) && fabs(normal[2])>fabs(normal[1]))
+ {right[0]=0;right[1]=normal[2];right[2]=-normal[1];}
+ else {right[0]=normal[1];right[1]=-normal[0];right[2]=0;}
+ length=sqrt(right[0]*right[0]+right[1]*right[1]+right[2]*right[2]);
+ for(k=0;k<3;k++)right[k]/=length;
+ up[0]=normal[1]*right[2]-normal[2]*right[1];up[1]=normal[2]*right[0]-normal[0]*right[2];up[2]=normal[0]*right[1]-normal[1]*right[0];
+ length=sqrt(up[0]*up[0]+up[1]*up[1]+up[2]*up[2]);
+ for(k=0;k<3;k++)up[k]/=length;
+ for(i=0;i<4;i++)for(k=0;k<3;k++)vertices[0][i][k]=origin[k]+(i<2?32767:-32767)*right[k]+((i==0||i==3)?32767:-32767)*up[k];
+ for(i=0;i<count;i++)if(i!=face){
+  unsigned int next=0,other=side^1;
+  for(j=0;j<total;j++){
+   double *a=vertices[side][j],*b=vertices[side][(j+1)%total];
+   double da=a[0]*planes[i][0]+a[1]*planes[i][1]+a[2]*planes[i][2]-planes[i][3];
+   double db=b[0]*planes[i][0]+b[1]*planes[i][1]+b[2]*planes[i][2]-planes[i][3];
+   qboolean inside=da<=0.000001,otherinside=db<=0.000001;
+   if(inside){if(next>=512)return 0;for(k=0;k<3;k++)vertices[other][next][k]=a[k];next++;}
+   if(inside!=otherinside){
+    dot=da/(da-db);if(next>=512)return 0;
+    for(k=0;k<3;k++)vertices[other][next][k]=a[k]+(b[k]-a[k])*dot;
+    next++;
+   }
+  }
+  side=other;total=next;if(total<3)return 0;
+ }
+ if(total>capacity)return 0;
+ for(i=0;i<total;i++)for(k=0;k<3;k++)out[i][k]=vertices[side][i][k];
+ return total;
+}
